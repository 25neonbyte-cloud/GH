generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  nome       String
  cargo      String?
  role       Role     @default(USER)
  permissoes Json?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profissional Profissional?

  @@map("usuarios")
}

enum Role {
  ADMIN
  USER
}

model Paciente {
  id               String       @id @default(uuid())
  prontuario       String       @unique
  nome             String
  cpf              String?      @unique
  dataNascimento   DateTime
  sexo             Sexo?
  nomeAcompanhante String?
  telefoneContato  String?
  diagnostico      String?
  precaucoes       String[]
  internacoes      Internacao[]
  evolucoes        Evolucao[]
  medicoesClinicas MedicaoClinica[]
  problemasClinicos ProblemaClinico[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  updatedBy        String?

  @@index([nome])
  @@index([prontuario])
  @@map("pacientes")
}

enum Sexo {
  M
  F
  OUTRO
}

model Leito {
  id          String          @id @default(uuid())
  numero      String          @unique
  andar       Int
  tipo        TipoLeito
  status      StatusLeito     @default(LIVRE)
  observacoes String?
  internacoes Internacao[]
  bloqueios   BloqueioLeito[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedBy   String?

  @@index([status])
  @@index([numero])
  @@map("leitos")
}

enum TipoLeito {
  ENFERMARIA
  UTI
  ISOLAMENTO
  SEMI_INTENSIVO
}

enum StatusLeito {
  LIVRE
  OCUPADO
  BLOQUEADO
  MANUTENCAO
  RESERVADO
}

model BloqueioLeito {
  id         String      @id @default(uuid())
  leitoId    String
  leito      Leito       @relation(fields: [leitoId], references: [id])
  tipo       StatusLeito
  motivo     String
  dataInicio DateTime
  dataFim    DateTime?
  ativo      Boolean     @default(true)
  createdAt  DateTime    @default(now())
  createdBy  String
  liberadoEm DateTime?
  liberadoBy String?

  @@index([leitoId])
  @@map("bloqueios_leito")
}

model Internacao {
  id                    String           @id @default(uuid())
  pacienteId            String
  paciente              Paciente         @relation(fields: [pacienteId], references: [id])
  leitoId               String
  leito                  Leito            @relation(fields: [leitoId], references: [id])
  dataInternacao        DateTime
  previsaoAlta          DateTime?
  dataAlta              DateTime?
  observacoesInternacao String?
  observacoesAlta       String?
  status                StatusInternacao @default(ATIVA)
  createdAt             DateTime         @default(now())
  createdBy             String
  dataAltaRegistrada    DateTime?
  altaBy                String?
  evolucoes              Evolucao[]
  medicoesClinicas       MedicaoClinica[]
  problemasClinicos      ProblemaClinico[]

  @@index([pacienteId])
  @@index([leitoId])
  @@index([status])
  @@map("internacoes")
}

enum StatusInternacao {
  ATIVA
  FINALIZADA
}

model Evolucao {
  id                String       @id @default(uuid())
  pacienteId        String
  paciente          Paciente     @relation(fields: [pacienteId], references: [id])
  internacaoId      String?
  internacao        Internacao?  @relation(fields: [internacaoId], references: [id], onDelete: SetNull)
  profissionalId    String?
  profissional      Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  templateId        String?
  template          TemplateEvolucao? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersao    Int?
  conteudo          Json?
  evolucaoOrigemId  String?
  evolucaoOrigem    Evolucao?    @relation("EvolucaoOrigem", fields: [evolucaoOrigemId], references: [id], onDelete: SetNull)
  derivadas         Evolucao[]    @relation("EvolucaoOrigem")
  camposHerdados    Json?
  assinadaEm        DateTime?
  sinaisVitais      Json?
  queixas           String?
  condutaMedica     String?
  medicacoes        String?
  observacoes       String
  tipo              TipoEvolucao @default(ENFERMAGEM)
  criadoPor         String
  criadoPorNome     String
  criadoPorCargo    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  updatedBy         String?
  medicoesClinicas  MedicaoClinica[]

  @@index([pacienteId])
  @@index([internacaoId])
  @@index([profissionalId])
  @@index([templateId])
  @@index([createdAt])
  @@map("evolucoes")
}

enum TipoEvolucao {
  ENFERMAGEM
  MEDICA
  MULTIPROFISSIONAL
}

model Profissional {
  id               String   @id @default(uuid())
  nome             String
  registroConselho String   @unique
  cargo            String
  ativo            Boolean  @default(true)
  usuarioId        String?  @unique
  usuario          Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  escalas          Escala[]
  evolucoes        Evolucao[]
  medicoesClinicas MedicaoClinica[]
  problemasCriados ProblemaClinico[] @relation("ProblemaCriadoPor")
  eventosProblema  ProblemaClinicoEvento[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  updatedBy        String?

  @@index([nome])
  @@map("profissionais")
}

model Escala {
  id             String       @id @default(uuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  data           DateTime
  turno          Turno
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  updatedBy      String?

  @@unique([profissionalId, data, turno])
  @@index([data])
  @@map("escalas")
}

enum Turno {
  MANHA
  TARDE
  NOITE
}

model LogImportacao {
  id             String   @id @default(uuid())
  tipo           String
  arquivo        String
  resultado      Json
  importadoPor   String
  dataImportacao DateTime @default(now())

  @@map("logs_importacao")
}

model TemplateEvolucao {
  id                    String     @id @default(uuid())
  codigo                String
  nome                  String
  categoriaProfissional String
  versao                Int        @default(1)
  ativo                 Boolean    @default(true)
  schema                Json
  interface             Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  evolucoes             Evolucao[]

  @@unique([codigo, versao])
  @@index([categoriaProfissional, ativo])
  @@map("templates_evolucao")
}

model MedicaoClinica {
  id             String        @id @default(uuid())
  pacienteId     String
  paciente       Paciente      @relation(fields: [pacienteId], references: [id])
  internacaoId   String?
  internacao     Internacao?   @relation(fields: [internacaoId], references: [id], onDelete: SetNull)
  evolucaoId     String?
  evolucao       Evolucao?     @relation(fields: [evolucaoId], references: [id], onDelete: SetNull)
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  codigo         String
  valorNumerico  Float?
  valorTexto     String?
  unidade        String?
  observadoEm    DateTime      @default(now())
  criadoPor      String
  createdAt      DateTime      @default(now())

  @@index([pacienteId, codigo, observadoEm])
  @@index([internacaoId])
  @@index([evolucaoId])
  @@map("medicoes_clinicas")
}

model ProblemaClinico {
  id                    String        @id @default(uuid())
  pacienteId            String
  paciente              Paciente      @relation(fields: [pacienteId], references: [id])
  internacaoId          String?
  internacao            Internacao?   @relation(fields: [internacaoId], references: [id], onDelete: SetNull)
  descricao             String
  codigo                String?
  status                String        @default("ATIVO")
  iniciadoEm            DateTime      @default(now())
  resolvidoEm           DateTime?
  criadoPorProfissionalId String?
  criadoPorProfissional Profissional? @relation("ProblemaCriadoPor", fields: [criadoPorProfissionalId], references: [id], onDelete: SetNull)
  createdBy             String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  eventos               ProblemaClinicoEvento[]

  @@index([pacienteId, status])
  @@index([internacaoId])
  @@map("problemas_clinicos")
}

model ProblemaClinicoEvento {
  id             String        @id @default(uuid())
  problemaId     String
  problema       ProblemaClinico @relation(fields: [problemaId], references: [id], onDelete: Cascade)
  tipo           String
  valorAnterior  Json?
  valorNovo      Json?
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  criadoPor      String
  ocorridoEm     DateTime      @default(now())

  @@index([problemaId, ocorridoEm])
  @@map("problemas_clinicos_eventos")
}
